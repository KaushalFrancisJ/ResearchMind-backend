# Database
DATABASE_DIALECT=postgresql+psycopg
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=password
DEFAULT_DATABASE=postgres

# Environment: development = Ollama, production = Groq
ENV=development

# Ollama (development)
OLLAMA_URL=http://localhost:11434
OLLAMA_FAST_MODEL=phi4-mini:3.8b-q4_K_M
OLLAMA_THINKING_MODEL=phi4-mini-reasoning:3.8b-q4_K_M

# Groq (production)
GROQ_API_KEY=your_groq_api_key_here
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_THINKING_MODEL=qwen-qwq-32b

# HuggingFace Inference API (embeddings)
HF_TOKEN=your_huggingface_token_here
